# Python environments and caches.
# The glob matters: candidate-evaluation environments such as .venv-transport-bench are
# hundreds of megabytes and must not be committable by accident.
.venv/
.venv-*/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Everything under artifacts/ is regenerated by the just recipes
# (synthetic-calibration, test-e2e, playwright-cli). Keeping it out of the
# repository avoids shipping stale evidence from another machine.
artifacts/

# Measured hardware profiles are machine specific.
config/hardware_profile.measured.json

# Personal face models and the profile paths that reference them are biometric data.
# Keep the checked-in demo profile only; store real shape.pcd files outside this repository.
config/user_profile.measured.json
config/private/

# Model weights are fetched on first run by the FaceMesh component.
models/

# Scratch space.
temp/

# Editor and OS state.
.vscode/
.idea/
.serena/
.DS_Store
Thumbs.db
